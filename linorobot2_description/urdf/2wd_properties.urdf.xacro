<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:property name="base_length" value="0.32" />
  <xacro:property name="base_width" value="0.38" />
  <xacro:property name="base_height" value="0.09" />
  <xacro:property name="base_mass" value="13" />
  <xacro:property name="base_mesh_file" value="" />

  <xacro:property name="wheel_radius" value="0.0535" />
  <xacro:property name="wheel_width" value="0.053" />
  <!-- 앞 캐스터 1개 구성: 구동 바퀴를 중심보다 5cm 뒤로 배치해 후방 안정성 확보 -->
  <xacro:property name="wheel_pos_x" value="-0.05" />
  <!-- wheel_pos_y = base_width / 2 = 0.38 / 2 -->
  <xacro:property name="wheel_pos_y" value="0.19" />
  <!-- wheel_pos_z = -(base_height / 2) = -(0.09 / 2), 바퀴 중심을 본체 바닥면에 정렬 -->
  <xacro:property name="wheel_pos_z" value="-0.045" />
  <xacro:property name="wheel_mass" value="0.3" />
  <xacro:property name="wheel_torque" value="20" />
  <xacro:property name="front_caster_wheel" value="true" />
  <xacro:property name="rear_caster_wheel" value="false" />

  <xacro:property name="wheel_mesh_file" value="" />
  <xacro:property name="laser_pose">
    <origin xyz="0.0 0 0.095" rpy="0 0 0"/>
  </xacro:property>

  <!-- 깊이 카메라: 본체 전면 중앙 높이 -->
  <xacro:property name="depth_sensor_pose">
    <origin xyz="0.16 0.0 0.5" rpy="0 0 0"/>
  </xacro:property>

  <xacro:property name="rear_camera_sensor_pose">
    <origin xyz="-0.14 0.0 0.045" rpy="0 0 3.14159"/>
  </xacro:property>

</robot>