<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- stroke: 리니어 액추에이터 스트로크(m). 0이면 고정 조인트(기존 동작 유지).
       >0이면 camera_to_base_link가 prismatic이 되어 카메라를 +X로 전개할 수 있음.
       origin은 항상 '수납(전개량 0)' 위치를 가리킨다.
       tilt: 틸트 관절 최대각(rad). 0이면 관절 없이 카메라가 붐에 직결(기존 동작).
             >0이면 camera_tilt_joint(+Y 회전)가 생겨 0=정면, tilt=바닥. -->
  <xacro:macro name="depth_sensor" params="*origin stroke:=0 tilt:=0">
    <!-- Intel RealSense L515 -->
    <link name="camera_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file:///opt/ros/humble/share/realsense2_description/meshes/l515.dae"/>
        </geometry>
      </visual>
      <collision>
        <!-- L515: 직경 61mm, 두께 26mm 원통으로 근사 -->
        <origin xyz="0 0 0" rpy="0 1.5708 0"/>
        <geometry>
          <cylinder radius="0.0305" length="0.026"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.1"/>
        <inertia ixx="0.000025" ixy="0.0" ixz="0.0"
                 iyy="0.000025" iyz="0.0"
                 izz="0.000025"/>
      </inertial>
    </link>

    <xacro:if value="${stroke == 0}">
      <joint name="camera_to_base_link" type="fixed">
        <parent link="base_link"/>
        <child link="camera_mount_link"/>
        <xacro:insert_block name="origin"/>
      </joint>
    </xacro:if>
    <xacro:unless value="${stroke == 0}">
      <!-- 리니어 액추에이터: 0=수납(주행), stroke=최대 전개 -->
      <joint name="camera_to_base_link" type="prismatic">
        <parent link="base_link"/>
        <child link="camera_mount_link"/>
        <xacro:insert_block name="origin"/>
        <axis xyz="1 0 0"/>
        <limit lower="0" upper="${stroke}" effort="50" velocity="0.05"/>
        <dynamics damping="20.0" friction="5.0"/>
      </joint>
    </xacro:unless>

    <!-- 붐 끝(리니어 액추에이터의 이동단). 틸트 서보가 여기 붙는다. -->
    <link name="camera_mount_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.01"/>
        <inertia ixx="0.000025" ixy="0.0" ixz="0.0"
                 iyy="0.000025" iyz="0.0"
                 izz="0.000025"/>
      </inertial>
    </link>

    <xacro:if value="${tilt == 0}">
      <joint name="camera_tilt_joint" type="fixed">
        <parent link="camera_mount_link"/>
        <child link="camera_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </joint>
    </xacro:if>
    <xacro:unless value="${tilt == 0}">
      <!-- 틸트 서보: 0=정면(+X), tilt=바닥(-Z). +Y 회전이 +X를 -Z로 보낸다. -->
      <joint name="camera_tilt_joint" type="revolute">
        <parent link="camera_mount_link"/>
        <child link="camera_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="0" upper="${tilt}" effort="20" velocity="1.0"/>
        <dynamics damping="2.0" friction="0.5"/>
      </joint>
    </xacro:unless>

    <link name="camera_depth_link"/>
    <joint name="camera_depth_joint" type="fixed">
      <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
      <parent link="camera_link"/>
      <child link="camera_depth_link"/>
    </joint>

    <!-- Gazebo Classic 11 depth camera — L515 스펙 -->
    <gazebo reference="camera_link">
      <sensor name="camera" type="depth">
        <always_on>true</always_on>
        <update_rate>10.0</update_rate>
        <visualize>false</visualize>
        <camera name="camera">
          <!-- L515 depth FOV: 70° horizontal = 1.2217 rad -->
          <horizontal_fov>1.2217</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.25</near>
            <far>9.0</far>
          </clip>
        </camera>
        <plugin name="depth_camera_controller" filename="libgazebo_ros_camera.so">
          <camera_name>camera</camera_name>
          <frame_name>camera_depth_link</frame_name>
          <min_depth>0.25</min_depth>
          <max_depth>9.0</max_depth>
        </plugin>
      </sensor>
    </gazebo>

    <!-- 리니어 액추에이터 구동/상태 (ros2_control 없이 Gazebo 플러그인으로 처리).
         전개: /set_joint_trajectory (trajectory_msgs/JointTrajectory) 발행
               joint_names=['camera_to_base_link'], positions=[0~stroke]
               ⚠️ header.frame_id 는 반드시 'base_footprint' (Gazebo에서 고정조인트가
                  base_footprint로 병합되어 base_link 링크는 존재하지 않음)
         상태: /joint_states 의 camera_to_base_link 가 현재 전개량(m)
         검증(2026-08-01): 전개 0.15 명령 → 0.1474, 수납 0 명령 → 0.0004 -->
    <xacro:unless value="${stroke == 0}">
      <gazebo>
        <plugin name="camera_boom_traj" filename="libgazebo_ros_joint_pose_trajectory.so">
          <update_rate>50</update_rate>
        </plugin>
        <plugin name="camera_boom_state" filename="libgazebo_ros_joint_state_publisher.so">
          <update_rate>20</update_rate>
          <joint_name>camera_to_base_link</joint_name>
          <joint_name>camera_tilt_joint</joint_name>
        </plugin>
      </gazebo>
    </xacro:unless>
  </xacro:macro>
</robot>
