<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="depth_sensor" params="*origin">
    <!-- Intel RealSense L515 -->
    <link name="camera_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file:///opt/ros/humble/share/realsense2_description/meshes/l515.dae"/>
        </geometry>
      </visual>
      <collision>
        <!-- L515: 직경 61mm, 두께 26mm 원통으로 근사 -->
        <origin xyz="0 0 0" rpy="0 1.5708 0"/>
        <geometry>
          <cylinder radius="0.0305" length="0.026"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.1"/>
        <inertia ixx="0.000025" ixy="0.0" ixz="0.0"
                 iyy="0.000025" iyz="0.0"
                 izz="0.000025"/>
      </inertial>
    </link>

    <joint name="camera_to_base_link" type="fixed">
      <parent link="base_link"/>
      <child link="camera_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <link name="camera_depth_link"/>
    <joint name="camera_depth_joint" type="fixed">
      <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
      <parent link="camera_link"/>
      <child link="camera_depth_link"/>
    </joint>

    <!-- Gazebo Harmonic rgbd_camera — L515 스펙 -->
    <gazebo reference="camera_link">
      <sensor name="camera" type="rgbd_camera">
        <topic>camera</topic>
        <update_rate>10.0</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <camera>
          <optical_frame_id>camera_depth_link</optical_frame_id>
          <!-- L515 depth FOV: 70° horizontal = 1.2217 rad -->
          <horizontal_fov>1.2217</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <!-- L515 depth range: 0.25m ~ 9.0m -->
            <near>0.25</near>
            <far>9.0</far>
          </clip>
        </camera>
        <plugin name="depth_camera_controller" filename="libgazebo_ros_camera.so">
          <ros>
            <remapping>/camera/camera_info:=/camera/color/camera_info</remapping>
            <remapping>/camera/image_raw:=/camera/color/image_raw</remapping>
            <remapping>/camera/points:=/camera/depth/color/points</remapping>
            <remapping>/camera/depth/image_raw:=/camera/depth/image_rect_raw</remapping>
            <qos>
              <topic name="/camera/depth/color/points">
                <publisher>
                  <reliability>best_effort</reliability>
                </publisher>
              </topic>
            </qos>
          </ros>
          <min_depth>0.015</min_depth>
          <max_depth>3.0</max_depth>
          <hack_baseline>0.07</hack_baseline>
          <frame_name>camera_depth_link</frame_name>
          <distortion_k1>0.00000001</distortion_k1>
          <distortion_k2>0.00000001</distortion_k2>
          <distortion_k3>0.00000001</distortion_k3>
          <distortion_t1>0.00000001</distortion_t1>
          <distortion_t2>0.00000001</distortion_t2>
        </plugin>
      </sensor>

    </gazebo>
  </xacro:macro>
</robot>
