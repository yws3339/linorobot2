<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="caster_wheel" params="side mass caster_x caster_radius wheel_radius wheel_pos_z">
    <xacro:property name="caster_wheel_radius" value="${caster_radius}" />
    <xacro:property name="caster_wheel_x" value="${caster_x}" />
    
    <link name="${side}_caster_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${caster_wheel_radius}" />
        </geometry>
        <material name="black">
            <color rgba="0.0 0.0 0.0 1.0"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${caster_wheel_radius}" />
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="${(2/5) * mass * (caster_wheel_radius * caster_wheel_radius)}" ixy="0" ixz="0"
                 iyy="${(2/5) * mass * (caster_wheel_radius * caster_wheel_radius)}" iyz="0"
                 izz="${(2/5) * mass * (caster_wheel_radius * caster_wheel_radius)}" />
      </inertial>
    </link>

    <gazebo reference="${side}_caster_wheel_link">
        <mu1>0.01</mu1>
        <mu2>0.01</mu2>
    </gazebo>

    <joint name="${side}_caster_wheel_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${side}_caster_wheel_link"/>
      <!-- 캐스터 최하점을 구동바퀴 최하점에 맞춘다.
           z를 -0.100으로 하드코딩하던 값은 인휠모터 실측(wheel_radius 0.045→0.0695,
           wheel_pos_z -0.03→-0.09) 반영 시 함께 갱신되지 않아, 캐스터가 바퀴보다
           0.5mm 아래로 내려가 있었다. 그 결과 로봇이 캐스터에 얹혀 구동바퀴 접지가
           빠지면서 회전과 가속이 제대로 안 됐다.
           매크로가 wheel_radius/wheel_pos_z를 이미 받고 있으므로 그걸로 계산한다. -->
      <origin xyz="${caster_wheel_x} 0 ${wheel_pos_z - wheel_radius + caster_wheel_radius}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
</robot>