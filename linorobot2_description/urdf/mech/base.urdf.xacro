<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="base" params="length width height mass wheel_radius wheel_pos_z origin_x origin_y origin_z com_offset_x:=0">
    <link name="base_footprint"/>

    <link name="base_link">
      <visual>
        <origin xyz="${base_mesh_xyz}" rpy="${base_mesh_rpy}"/>
        <geometry>
          <mesh filename="${base_mesh_file}" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="robot_body">
          <color rgba="0.3 0.3 0.3 1.0"/>
        </material>
      </visual>

      <collision>
        <origin xyz="${origin_x} ${origin_y} ${origin_z}" rpy="0 0 0"/>
        <geometry>
          <box size="${length} ${width} ${height}"/>
        </geometry>
      </collision>

      <!-- 무게중심은 충돌박스 기하중심과 다르다. 충돌박스는 CAD 외곽이지만 실제 질량은
           인휠모터(바퀴축)와 배터리·ODrive가 있는 뒤쪽에 몰려 있다. 둘을 같은 origin으로
           묶으면 무게중심이 앞으로 끌려가 구동바퀴 하중이 빠지고 회전·가속이 죽는다.
           com_offset_x 기본 0이라 다른 로봇 설정은 기존 동작 그대로다. -->
      <inertial>
        <origin xyz="${origin_x + com_offset_x} ${origin_y} ${origin_z}" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="${(1/12) * mass * ((width  * width)  + (height * height))}" ixy="0.0" ixz="0.0"
                 iyy="${(1/12) * mass * ((length * length) + (height * height))}" iyz="0.0"
                 izz="${(1/12) * mass * ((length * length) + (width  * width))}"/>
      </inertial>
    </link>

    <!-- <gazebo>는 <link> 바깥에 와야 한다. 안에 두면 URDF 파서가 무시해
         Gazebo 머티리얼이 적용되지 않는다 (업스트림도 바깥). -->
    <gazebo reference="base_link">
      <visual>
        <material>
          <ambient>0.3 0.3 0.3 1.0</ambient>
          <diffuse>0.5 0.5 0.5 1.0</diffuse>
          <specular>0.2 0.2 0.2 1.0</specular>
        </material>
      </visual>
    </gazebo>

    <joint name="base_to_footprint" type="fixed">
      <parent link="base_footprint"/>
      <child link="base_link"/>
      <origin xyz="0 0 ${wheel_radius - wheel_pos_z}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
</robot>