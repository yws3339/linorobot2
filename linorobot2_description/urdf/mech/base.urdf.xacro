<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="base" params="length width height mass wheel_radius wheel_pos_z origin_x origin_y origin_z">
    <link name="base_footprint"/>

    <link name="base_link">
      <visual>
        <origin xyz="0.235 -0.050 0.003" rpy="0 0 1.5708"/>
        <geometry>
          <mesh filename="${base_mesh_file}" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="robot_body">
          <color rgba="0.3 0.3 0.3 1.0"/>
        </material>
      </visual>

    <gazebo reference="base_link">
      <visual>
        <material>
          <ambient>0.3 0.3 0.3 1.0</ambient>
          <diffuse>0.5 0.5 0.5 1.0</diffuse>
          <specular>0.2 0.2 0.2 1.0</specular>
        </material>
      </visual>
    </gazebo>

      <collision>
        <origin xyz="${origin_x} ${origin_y} ${origin_z}" rpy="0 0 0"/>
        <geometry>
          <box size="${length} ${width} ${height}"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="${origin_x} ${origin_y} ${origin_z}" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="${(1/12) * mass * ((width  * width)  + (height * height))}" ixy="0.0" ixz="0.0"
                 iyy="${(1/12) * mass * ((length * length) + (height * height))}" iyz="0.0"
                 izz="${(1/12) * mass * ((length * length) + (width  * width))}"/>
      </inertial>
    </link>


    <joint name="base_to_footprint" type="fixed">
      <parent link="base_footprint"/>
      <child link="base_link"/>
      <origin xyz="0 0 ${wheel_radius - wheel_pos_z}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
</robot>