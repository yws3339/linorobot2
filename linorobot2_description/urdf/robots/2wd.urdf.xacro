<?xml version="1.0"?>
<robot name="linorobot2_2wd" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:arg name="use_scara" default="true"/>
  <xacro:property name="use_scara" value="$(arg use_scara)"/>

  <xacro:include filename="$(find linorobot2_description)/urdf/2wd_properties.urdf.xacro" />
  <xacro:include filename="$(find linorobot2_description)/urdf/mech/base.urdf.xacro" />
  <xacro:include filename="$(find linorobot2_description)/urdf/mech/wheel.urdf.xacro" />
  <xacro:include filename="$(find linorobot2_description)/urdf/mech/caster_wheel.urdf.xacro" />
  <xacro:include filename="$(find linorobot2_description)/urdf/sensors/imu.urdf.xacro" />
  <xacro:include filename="$(find linorobot2_description)/urdf/sensors/optical_flow.urdf.xacro" />
  <xacro:include filename="$(find linorobot2_description)/urdf/sensors/generic_laser.urdf.xacro" />
  <xacro:include filename="$(find linorobot2_description)/urdf/sensors/depth_sensor.urdf.xacro" />
  <xacro:include filename="$(find linorobot2_description)/urdf/sensors/camera.urdf.xacro" />
  <xacro:if value="${use_scara}">
    <xacro:include filename="$(find scara_description)/urdf/scara_macro.xacro" />
  </xacro:if>
  <xacro:include filename="$(find linorobot2_description)/urdf/controllers/diff_drive.urdf.xacro" />

  <xacro:base
    length="${base_length}"
    width="${base_width}"
    height="${base_height}"
    mass="${base_mass}"
    wheel_radius="${wheel_radius}"
    wheel_pos_z="${wheel_pos_z}"
    origin_x="${base_origin_x}"
    origin_y="${base_origin_y}"
    origin_z="${base_origin_z}"
/>

  <xacro:wheel 
    side="left"
    radius="${wheel_radius}" 
    width="${wheel_width}" 
    pos_x="${wheel_pos_x}" 
    pos_y="${wheel_pos_y}" 
    pos_z="${wheel_pos_z}" 
    mass="${wheel_mass}"
  />

  <xacro:wheel 
    side="right"
    radius="${wheel_radius}" 
    width="${wheel_width}" 
    pos_x="${wheel_pos_x}" 
    pos_y="${-wheel_pos_y}" 
    pos_z="${wheel_pos_z}" 
    mass="${wheel_mass}"
  />

  <!-- caster_x: rescuepang_v3 CAD 실측 접지점 X=595mm (좌우 Y=±191, 단일 중앙 캐스터로 근사).
       구 0.291은 새 무게중심(base_origin_x=0.290)과 겹쳐 구동바퀴 하중이 0%가 됨 -->
  <xacro:if value="${front_caster_wheel}">
    <xacro:caster_wheel
      side="front"
      mass="0.01"
      caster_x="0.595"
      caster_radius="0.060"
      wheel_radius="${wheel_radius}"
      wheel_pos_z="${wheel_pos_z}"
    />
  </xacro:if>

  <xacro:if value="${rear_caster_wheel}">
    <xacro:caster_wheel
      side="rear"
      mass="0.01"
      caster_x="-0.191"
      caster_radius="0.060"
      wheel_radius="${wheel_radius}"
      wheel_pos_z="${wheel_pos_z}"
    />
  </xacro:if>

  <xacro:imu/>
  <xacro:optical_flow/>

  <xacro:generic_laser>
    <xacro:insert_block name="laser_pose" />
  </xacro:generic_laser>
  
  <!-- 카메라 리니어 액추에이터 스트로크 150mm (실물 사양).
       depth_sensor_pose는 수납 위치이며, 전개 시 +X로 최대 0.15m 이동 -->
  <xacro:depth_sensor stroke="${camera_boom_stroke}" tilt="${camera_tilt_max}">
    <xacro:insert_block name="depth_sensor_pose" />
  </xacro:depth_sensor>

  <xacro:rgb_camera
      parent="base_link"
      name="rear_rgb_camera"
      topic_name="rear_rgb_camera/image">
    <xacro:insert_block name="rear_camera_sensor_pose" />
  </xacro:rgb_camera>

  <!-- SCARA(CPR 모듈). 팔 회전면이 차체와 같은 높이이므로 타깃은 차체 앞(로버 X>0.65)에만 둔다. -->
  <xacro:if value="${use_scara}">
    <xacro:scara parent="base_link">
      <origin xyz="${scara_mount_xyz}" rpy="${scara_mount_rpy}"/>
    </xacro:scara>
  </xacro:if>

  <xacro:diff_drive_controller
    wheel_separation="${wheel_pos_y * 2}"
    wheel_radius="${wheel_radius}"
    wheel_torque="${wheel_torque}"
  />
</robot>