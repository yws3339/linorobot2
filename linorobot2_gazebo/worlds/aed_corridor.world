<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="aed_corridor">

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.85 0.9 0.95 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.6</constant>
        <linear>0.005</linear>
        <quadratic>0.0005</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <light name="ceiling_1" type="point">
      <pose>2 0 2.5 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <attenuation><range>8</range><constant>0.4</constant><linear>0.05</linear><quadratic>0.01</quadratic></attenuation>
    </light>
    <light name="ceiling_2" type="point">
      <pose>6 0 2.5 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <attenuation><range>8</range><constant>0.4</constant><linear>0.05</linear><quadratic>0.01</quadratic></attenuation>
    </light>
    <light name="ceiling_3" type="point">
      <pose>10 0 2.5 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <attenuation><range>8</range><constant>0.4</constant><linear>0.05</linear><quadratic>0.01</quadratic></attenuation>
    </light>

    <!-- 바닥 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 복도 북쪽 벽 (긴 벽) — 14m -->
    <model name="wall_north">
      <static>true</static>
      <pose>5 2 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>14.2 0.1 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>14.2 0.1 1.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 복도 남쪽 벽 -->
    <model name="wall_south">
      <static>true</static>
      <pose>5 -2 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>14.2 0.1 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>14.2 0.1 1.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 복도 서쪽 끝 벽 (멀리, x=12) -->
    <model name="wall_west_end">
      <static>true</static>
      <pose>12 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 4.2 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.1 4.2 1.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 복도 동쪽 끝 벽 (로봇 뒤, x=-2) -->
    <model name="wall_east_end">
      <static>true</static>
      <pose>-2 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 4.2 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.1 4.2 1.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 장애물 (로봇-사람 사이 경로) — x=4, y=0 -->
    <model name="obstacle_box">
      <static>true</static>
      <pose>4 0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.5 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.8</size></box></geometry>
          <material><ambient>0.4 0.25 0.1 1</ambient><diffuse>0.55 0.35 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 쓰러진 사람 — x=8, y=-0.5, 복도를 가로질러 누움(yaw 90°).
         로컬 +x가 월드 +y가 되므로 발끝 y=-1.35, 몸통 y=-0.175, 머리 y=+0.28.
         복도 중앙(y≈0)으로 접근하는 로버가 환자의 가슴·어깨 쪽에 마주 서게 되어
         SCARA가 압박점·패드 부착점에 닿는다. -->
    <model name="fallen_person">
      <static>true</static>
      <pose>8 -0.5 0 0 0 1.5708</pose>
      <link name="link">
        <!-- 다리 (x축으로 누움) -->
        <collision name="leg_l_col">
          <pose>-0.425 0.07 0.1 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>0.85</length></cylinder></geometry>
        </collision>
        <visual name="leg_l_vis">
          <pose>-0.425 0.07 0.1 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>0.85</length></cylinder></geometry>
          <material><ambient>0.1 0.15 0.4 1</ambient><diffuse>0.15 0.2 0.55 1</diffuse></material>
        </visual>
        <collision name="leg_r_col">
          <pose>-0.425 -0.07 0.1 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>0.85</length></cylinder></geometry>
        </collision>
        <visual name="leg_r_vis">
          <pose>-0.425 -0.07 0.1 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>0.85</length></cylinder></geometry>
          <material><ambient>0.1 0.15 0.4 1</ambient><diffuse>0.15 0.2 0.55 1</diffuse></material>
        </visual>
        <!-- 몸통 -->
        <collision name="torso_col">
          <pose>0.325 0 0.13 0 0 0</pose>
          <geometry><box><size>0.65 0.42 0.25</size></box></geometry>
        </collision>
        <visual name="torso_vis">
          <pose>0.325 0 0.13 0 0 0</pose>
          <geometry><box><size>0.65 0.42 0.25</size></box></geometry>
          <material><ambient>0.7 0.15 0.15 1</ambient><diffuse>0.9 0.2 0.2 1</diffuse></material>
        </visual>
        <!-- 팔 -->
        <collision name="arm_l_col">
          <pose>0.35 0.26 0.13 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>0.6</length></cylinder></geometry>
        </collision>
        <visual name="arm_l_vis">
          <pose>0.35 0.26 0.13 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.7 0.15 0.15 1</ambient><diffuse>0.9 0.2 0.2 1</diffuse></material>
        </visual>
        <collision name="arm_r_col">
          <pose>0.35 -0.26 0.13 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>0.6</length></cylinder></geometry>
        </collision>
        <visual name="arm_r_vis">
          <pose>0.35 -0.26 0.13 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.7 0.15 0.15 1</ambient><diffuse>0.9 0.2 0.2 1</diffuse></material>
        </visual>
        <!-- 머리 -->
        <collision name="head_col">
          <pose>0.78 0 0.13 0 0 0</pose>
          <geometry><sphere><radius>0.13</radius></sphere></geometry>
        </collision>
        <visual name="head_vis">
          <pose>0.78 0 0.13 0 0 0</pose>
          <geometry><sphere><radius>0.13</radius></sphere></geometry>
          <material><ambient>0.9 0.7 0.55 1</ambient><diffuse>1.0 0.8 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <!-- 기본 iters=50으로는 바퀴 속도모터의 "목표 0" 구속이 매 스텝 수렴하지 못해
           로버가 명령 없이 자기 기준 뒤로 초당 0.7mm 밀렸다(2026-08-08 규명).
           바퀴는 미끄러지지 않고 구름 조건대로 돌았고, 링크 전체가 강체로 함께
           움직였다. 토크를 20→200 N·m로 올려도 -0.706으로 미동도 없어 모터 포화가
           아니라 LCP 잔차임이 드러났다.
             iters  50 : -0.706 mm/s  (RTF 1.06 · gzserver 80%)
             iters 100 : -0.223 mm/s  (RTF 0.983 · gzserver 90%)
             iters 200 : +0.003 mm/s  (RTF 0.985 · gzserver 98%)
           100과 200은 RTF가 사실상 같은데 결과는 70배 차이라 200으로 잡았다.
           회전 추종률·전체 시나리오에는 회귀 없음(2026-08-08 확인). -->
      <ode>
        <solver>
          <iters>200</iters>
        </solver>
      </ode>
    </physics>

    <gravity>0 0 -9.81</gravity>

    <!-- 물리 문제를 팔 때는 아래를 켜면 링크별 실제 pose를 구동 플러그인과 무관하게
         볼 수 있다(/link_states, /model_states — ROS2판은 /gazebo/ 접두사가 없다).
         단 twist는 이 플러그인의 update_rate로 샘플링한 순간값이라 그대로 믿으면 안 된다.
         위치 차분으로 구할 것.
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <update_rate>100</update_rate>
    </plugin>
    -->


    <gui>
      <camera name="user_camera">
        <pose>-3 0 6 0 0.7 0</pose>
      </camera>
    </gui>

  </world>
</sdf>
